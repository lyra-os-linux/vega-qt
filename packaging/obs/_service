<services>
  <service name="tar_scm">
    <param name="scm">git</param>
    <param name="url">https://github.com/lyra-os-linux/vega-qt.git</param>
    <param name="revision">main</param>
    <param name="match-tag">qt-v*</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">qt-v(.*)</param>
    <param name="versionrewrite-replacement">\1</param>
    <param name="exclude">.git</param>
    <param name="exclude">build</param>
    <param name="filename">vega-qt-src</param>
  </service>
  <service name="set_version" />
</services>
