[Desktop Entry]
Type=Application
Name=Vega Update Notifier
Comment=Notify when Lyra OS updates are available
Comment[pt_BR]=Avisa quando houver atualizações do Lyra OS
Comment[es]=Avisa cuando haya actualizaciones de Lyra OS
Exec=/usr/bin/vega-update-notifier-qt
Icon=system-software-update
Terminal=false
NoDisplay=true
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
